VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Accès admin (suppression de parties dans l'historique).
# Hachage argon2id du mot de passe, écrit automatiquement par : bun scripts/hash-admin-password.ts
# Ne pas l'écrire à la main : les $ du hachage doivent être échappés (\$), sinon il est illisible.
# À mettre dans .env (jamais versionné). Sans cette variable, l'accès admin est désactivé.
# Ne jamais préfixer par VITE_ : ce qui commence par VITE_ est inclus dans le code envoyé aux navigateurs.
SK_ADMIN_PASSWORD_HASH=
